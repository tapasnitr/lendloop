{
  "name": "LendLoop - Overdue reminders",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 9 }] }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.CONVEX_SITE_URL }}/api/overdue",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 10000 }
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_AFTER_IMPORT", "name": "Convex API Key" }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "// MOCK reminder: logged only. Swap for Email / Slack / Discord in production.\nconst out = [];\nfor (const item of $input.all()) {\n  const l = item.json;\n  console.log(`[REMINDER] ${l.borrowerName} <${l.borrowerEmail}>: ${l.toolName} was due ${l.endDate} (${l.daysOverdue}d overdue)`);\n  out.push({ json: { loanId: l.loanId, idempotencyKey: l.idempotencyKey, status: 'sent', detail: 'mock reminder logged' } });\n}\nreturn out;"
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Send reminder (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/api/reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ loanId: $json.loanId, idempotencyKey: $json.idempotencyKey, status: $json.status, detail: $json.detail }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Write back to Convex (idempotent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_AFTER_IMPORT", "name": "Convex API Key" }
      }
    }
  ],
  "connections": {
    "Daily 09:00": { "main": [[{ "node": "Fetch overdue loans", "type": "main", "index": 0 }]] },
    "Fetch overdue loans": { "main": [[{ "node": "One item per loan", "type": "main", "index": 0 }]] },
    "One item per loan": { "main": [[{ "node": "Send reminder (mock)", "type": "main", "index": 0 }]] },
    "Send reminder (mock)": { "main": [[{ "node": "Write back to Convex (idempotent)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
