# --- Next.js / Clerk (copy to .env.local) ---
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Convex environment variables (set with `npx convex env set NAME value`) ---
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# ADMIN_EMAILS=you@example.com,other@example.com
# N8N_WEBHOOK_URL=https://<public-n8n-host>/webhook/lendloop-request
# N8N_WEBHOOK_SECRET=<long random string, shared with n8n>
# N8N_API_KEY=<long random string, n8n sends it as Bearer token>

# --- docker-compose / n8n (copy to .env next to docker-compose.yml) ---
N8N_WEBHOOK_SECRET=<same as Convex>
CONVEX_SITE_URL=https://your-deployment.convex.site
N8N_ENCRYPTION_KEY=<long random string>
N8N_PUBLIC_URL=http://localhost:5678
